From: hello_gpu <noreply@localhost>
Subject: [PATCH] Allocate system memory uncached on non DMA-coherent devices

The proprietary resource manager assumes cache-coherent PCIe DMA and
allocates cached system memory, which breaks on non-coherent hosts like
the Raspberry Pi 5. Force such allocations uncached in nv_alloc_pages()
(the open interface layer), unless nv_force_uncached_sysmem=0.
---
--- a/nvidia/nv.c	2025-09-23 12:17:32.000000000 +0200
+++ b/nvidia/nv.c	2026-10-07 13:28:54.135532166 +0200
@@ -3780,6 +3780,22 @@
     }
 }
 
+#if defined(NVCPU_AARCH64)
+#include <linux/dma-map-ops.h>
+
+/*
+ * The proprietary resource manager assumes PCIe DMA is cache-coherent and
+ * allocates cached system memory, which breaks on non-coherent hosts such as
+ * the Raspberry Pi 5: the CPU and the GPU see different data. Allocate that
+ * memory uncached instead (it then also gets uncached CPU mappings, see
+ * at->flags.aliased). Slower for the CPU but correct.
+ */
+static int nv_force_uncached_sysmem = 1;
+module_param(nv_force_uncached_sysmem, int, 0444);
+MODULE_PARM_DESC(nv_force_uncached_sysmem,
+                 "Allocate system memory uncached on non DMA-coherent devices (default 1)");
+#endif
+
 NV_STATUS NV_API_CALL nv_alloc_pages(
     nv_state_t *nv,
     NvU32       page_count,
@@ -3815,6 +3831,14 @@
        dev = nvl->dev;
     }
 
+#if defined(NVCPU_AARCH64)
+    if (nv_force_uncached_sysmem && (cache_type == NV_MEMORY_CACHED) &&
+        (dev != NULL) && !dev_is_dma_coherent(dev))
+    {
+        cache_type = NV_MEMORY_UNCACHED;
+    }
+#endif
+
     if (nv_encode_caching(NULL, cache_type, NV_MEMORY_TYPE_SYSTEM))
         return NV_ERR_NOT_SUPPORTED;
 
